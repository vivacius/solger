# FusionSolar Northbound API
FUSIONSOLAR_BASE_URL=https://la5.fusionsolar.huawei.com
FUSIONSOLAR_USERNAME=
FUSIONSOLAR_PASSWORD=
FUSIONSOLAR_VERIFY_SSL=true
FUSIONSOLAR_TIMEOUT=60

# Supabase (schema: solger)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
