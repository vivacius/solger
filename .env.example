# Mercado XM
ALLOW_MOCK_MARKET=false

# Factor CO2 UPME (tCO2eq/MWh - Res. UPME 000085 2024 inventario = 0.220)
CO2_FACTOR_T_PER_MWH=0.220

# Telegram (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SMTP (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_TO=

